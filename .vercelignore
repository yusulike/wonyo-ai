# Vercel Deployment Ignore List
# Exclude raw multi-gigabyte BitMEX logs and heavy local data
aoa_public_2021-12-31_with_letter*
*.zip
*.csv
*.parquet
# ...except the replay dataset bundled into serverless functions (see vercel.json)
!data/candles/bitmex_2021_q2_15m.parquet
.venv
__pycache__
*.pyc
tests
.pytest_cache
.git
.gemini
.agents

# Exclude local build/lock files that trigger full 500MB+ installs
uv.lock
pyproject.toml
