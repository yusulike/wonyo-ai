# Vercel Deployment Ignore List
# Exclude raw multi-gigabyte BitMEX logs and heavy local data
aoa_public_2021-12-31_with_letter*
*.zip
*.csv
*.parquet
.venv
__pycache__
*.pyc
tests
.pytest_cache
.git
.gemini
.agents

# Exclude local build/lock files that trigger full 500MB+ installs
uv.lock
pyproject.toml
